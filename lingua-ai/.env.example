# LinguaAI – Environment Configuration
# CodeAlpha Artificial Intelligence Internship Project

# Server Port (default: 3000)
PORT=3000

# Google Gemini API Key
# Get your free API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (optional, defaults to gemini-3.5-flash-lite)
# Supported options: gemini-3.5-flash-lite, gemini-3.1-flash-lite, gemini-3-flash-preview
GEMINI_MODEL=gemini-3.5-flash-lite
